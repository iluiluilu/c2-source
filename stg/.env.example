# Copy sang .env va dien gia tri that truoc khi `docker compose up -d`.
# KHONG commit file .env (chua secret).

# ---- Domains (tro ve server nay qua Cloudflare, proxy status = Proxied) ----
WEB_DOMAIN=web.green0tech.site
API_DOMAIN=api.green0tech.site
AUTH_DOMAIN=auth.green0tech.site
FILES_DOMAIN=files.green0tech.site

# ---- Images: build local (`docker build`), sau do `docker save` + scp len
# server roi `docker load`, hoac push len 1 registry va pull tren server.
# Xem README.md muc "Build & upload image". Tag phai khop voi tag da load/pull.
WEB_IMAGE=aismartstore-web:stg
API_IMAGE=aismartstore-api:stg

# ---- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=5wuN9q3hy1CQOyy4
KEYCLOAK_REALM=aismartstore
KEYCLOAK_CLIENT_ID=backend
# Phai khop voi secret cua client "backend" trong realm-export.json
# (hoac gia tri da chinh trong Keycloak admin console sau khi realm import).
KEYCLOAK_CLIENT_SECRET=5wuN9q3hy1CQOyy45wuN9q3hy1CQOyy4

# ---- Postgres ----
POSTGRES_USER=aismartstore
POSTGRES_PASSWORD=5wuN9q3hy1CQOyy4
POSTGRES_DB=aismartstore

# ---- SeaweedFS (S3-compatible storage) ----
# Phai khop voi config/seaweedfs/s3.json (file JSON tinh, khong doc bien env
# nay) - doi 1 trong 2 cho o day thi phai sua ca file kia.
S3_ACCESS_KEY_ID=aismartstore
S3_SECRET_ACCESS_KEY=5wuN9q3hy1CQOyy45wuN9q3hy1CQOyy4
S3_BUCKET=documents
S3_PERSONAL_BUCKET=personal
S3_REGION=us-east-1

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=aismartstore
RABBITMQ_DEFAULT_PASS=5wuN9q3hy1CQOyy4

# ---- OpenSearch ----
OPENSEARCH_INITIAL_ADMIN_PASSWORD=5wuN9q3hy1CQOyy4

# ---- NextAuth (web) ----
# openssl rand -base64 32
NEXTAUTH_SECRET=5wuN9q3hy1CQOyy45wuN9q3hy1CQOyy4
