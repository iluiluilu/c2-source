<?xml version="1.0" encoding="UTF-8"?>
<!--
Report template DOC_BY_CLASSIFICATION (Thống kê theo chủ đề và loại tài liệu).
Minimal layout (AC-25): page header = template code + name + period/filters; page footer = prepared-by, timestamp, scope notice, page number.
No agency name / signature block / document number. The body is a list of sections (TEXT | TABLE | CHART_BAR | CHART_STACKED) built by
ReportRenderService from the ReportResult DTO; table/chart sections are sub-reports fed by JRBeanCollectionDataSource.
There is NO <queryString> anywhere (AC-36; enforced by JrxmlGuardTest and by the precompiler).
The detail band is splitType="Prevent": a section (table title + its table) moves to the next page as a whole instead of
leaving the title orphaned at the bottom of a page; a section taller than a page still splits.
-->
<jasperReport name="doc_by_classification" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="780" leftMargin="31" rightMargin="31" topMargin="28" bottomMargin="28" uuid="dbca534f-b372-4de9-a0ea-97d68a2c65be">
	<style name="sans" fontName="AISS Sans" fontSize="9.0" pdfFontName="AISS Sans" pdfEncoding="Identity-H" pdfEmbedded="true"/>
	<style name="serif" fontName="Liberation Serif" fontSize="13.0" pdfFontName="Liberation Serif" pdfEncoding="Identity-H" pdfEmbedded="true"/>
	<parameter name="REPORT_CODE" class="java.lang.String"/>
	<parameter name="REPORT_NAME" class="java.lang.String"/>
	<parameter name="HEADER_LINE" class="java.lang.String"/>
	<parameter name="FOOTER_LINE" class="java.lang.String"/>
	<parameter name="SUBREPORT_TABLE" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUBREPORT_CHART_BAR" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUBREPORT_CHART_STACKED" class="net.sf.jasperreports.engine.JasperReport"/>
	<field name="kind" class="java.lang.String"/>
	<field name="title" class="java.lang.String"/>
	<field name="text" class="java.lang.String"/>
	<field name="ds" class="net.sf.jasperreports.engine.JRDataSource"/>
	<pageHeader height="62">
		<element kind="textField" uuid="471b145d-fcba-4dcc-a6ac-514688602091" x="0" y="0" width="780" height="18" bold="true" vTextAlign="Middle" style="serif">
			<expression><![CDATA[$P{REPORT_CODE} + " - " + $P{REPORT_NAME}]]></expression>
		</element>
		<element kind="textField" uuid="1834f487-4ac8-49c6-a8c6-45053a125f1b" x="0" y="20" width="780" height="40" vTextAlign="Top" style="sans">
			<expression><![CDATA[$P{HEADER_LINE}]]></expression>
		</element>
		<element kind="line" uuid="0af2aece-9ab3-4b25-bff4-692d0d29a259" x="0" y="60" width="780" height="1">
			<pen lineWidth="0.5"/>
		</element>
	</pageHeader>
	<detail>
		<band height="40" splitType="Prevent">
			<element kind="textField" uuid="f25b6c9a-03f4-4391-9b2a-17ad1e77acd9" x="0" y="0" width="780" height="16" positionType="Float" fontSize="10.0" textAdjust="StretchHeight" bold="true" blankWhenNull="true" vTextAlign="Middle" style="sans">
				<printWhenExpression><![CDATA["TABLE".equals($F{kind})]]></printWhenExpression>
				<expression><![CDATA[$F{title}]]></expression>
			</element>
			<element kind="textField" uuid="fdba88ee-0f4a-46f5-a159-b0bb5479e2b4" x="0" y="0" width="780" height="16" positionType="Float" stretchType="ElementGroupHeight" textAdjust="StretchHeight" blankWhenNull="true" vTextAlign="Top" style="sans">
				<printWhenExpression><![CDATA["TEXT".equals($F{kind})]]></printWhenExpression>
				<expression><![CDATA[$F{text}]]></expression>
			</element>
			<element kind="subreport" uuid="f557770e-6b5c-40b2-bccc-d21784f8b833" x="0" y="18" width="780" height="16" positionType="Float" usingCache="false">
				<printWhenExpression><![CDATA["TABLE".equals($F{kind})]]></printWhenExpression>
				<dataSourceExpression><![CDATA[$F{ds}]]></dataSourceExpression>
				<expression><![CDATA[$P{SUBREPORT_TABLE}]]></expression>
			</element>
			<element kind="subreport" uuid="4ec4ee78-4172-40ec-9c11-9ad24b5d8182" x="0" y="0" width="780" height="16" positionType="Float" usingCache="false">
				<printWhenExpression><![CDATA["CHART_BAR".equals($F{kind})]]></printWhenExpression>
				<parameter name="CHART_TITLE">
					<expression><![CDATA[$F{title}]]></expression>
				</parameter>
				<dataSourceExpression><![CDATA[$F{ds}]]></dataSourceExpression>
				<expression><![CDATA[$P{SUBREPORT_CHART_BAR}]]></expression>
			</element>
			<element kind="subreport" uuid="f0c8c0a1-4567-4528-9c58-79e8ba575970" x="0" y="0" width="780" height="16" positionType="Float" usingCache="false">
				<printWhenExpression><![CDATA["CHART_STACKED".equals($F{kind})]]></printWhenExpression>
				<parameter name="CHART_TITLE">
					<expression><![CDATA[$F{title}]]></expression>
				</parameter>
				<dataSourceExpression><![CDATA[$F{ds}]]></dataSourceExpression>
				<expression><![CDATA[$P{SUBREPORT_CHART_STACKED}]]></expression>
			</element>
			<element kind="staticText" uuid="05a870b6-be4d-4df4-b65f-79bc204f12ee" x="0" y="36" width="780" height="4" positionType="Float">
				<text><![CDATA[ ]]></text>
			</element>
		</band>
	</detail>
	<pageFooter height="34">
		<element kind="line" uuid="d7029278-a683-4ed2-93b4-c53dd6449fef" x="0" y="0" width="780" height="1">
			<pen lineWidth="0.5"/>
		</element>
		<element kind="textField" uuid="f7373662-71b9-4e96-bde1-295a5390da4a" x="0" y="3" width="690" height="28" vTextAlign="Top" style="sans">
			<expression><![CDATA[$P{FOOTER_LINE}]]></expression>
		</element>
		<element kind="textField" uuid="5e3aeb50-8f33-4147-9d0b-69dceb9213fd" x="690" y="3" width="90" height="14" hTextAlign="Right" vTextAlign="Top" style="sans">
			<expression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
