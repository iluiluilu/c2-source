# Development image: runs the app from source via spring-boot:run so that
# ./src mounted from the host is what actually executes.
#
# NOTE: pom.xml does not include spring-boot-devtools, so this does NOT
# auto-restart on file change - edit, then restart the container:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml restart backend
# Adding spring-boot-devtools to pom.xml would enable automatic restarts.
FROM maven:3.9-eclipse-temurin-21
WORKDIR /app

# digitization-pipeline-01-source-dispatch.md §4.2 step 4: SourceSeparationJobRunner
# shells out to the `ffmpeg` binary on PATH - not a Java library, must be present
# in this image too (base is Debian/Ubuntu, hence apt-get not apk).
#
# export-reporting (JasperReports): fontconfig/freetype/fonts-dejavu-core for headless AWT (charts, TTF loading).
#
# The base image's default sources point at plain http://ports.ubuntu.com;
# on some networks a transparent proxy/DPI corrupts large plain-HTTP package
# downloads in transit, which apt catches as "Hash Sum mismatch" on a
# different package each run. Forcing https for the same mirror avoids the
# interception and has fixed this reliably - see AGENTS.md/CLAUDE.md gotchas.
RUN sed -i 's|http://ports.ubuntu.com/ubuntu-ports/|https://ports.ubuntu.com/ubuntu-ports/|g' \
        /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends ffmpeg fontconfig libfreetype6 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Same dependency-caching trick as the production image; without it every
# container start would re-download the whole dependency tree.
COPY pom.xml ./
RUN mvn -B dependency:go-offline

COPY src ./src

EXPOSE 3001
CMD ["mvn", "-B", "spring-boot:run"]
